# Copia este archivo como .env.local para desarrollo y rellena los valores.
# En Vercel, añade las mismas variables en Settings → Environment Variables.

# Neon → tu proyecto → Connect → copia la "connection string" (con ?sslmode=require)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Clerk → tu aplicación → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Clave que enviarán los atajos del iPhone en la cabecera "Authorization: Bearer ..."
# Genera una larga y aleatoria (ver README).
INGEST_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Google AI Studio → Get API key
GEMINI_API_KEY=
# Modelo gratuito Flash-Lite (puedes cambiarlo sin tocar el código)
GEMINI_MODEL=gemini-3.5-flash-lite
